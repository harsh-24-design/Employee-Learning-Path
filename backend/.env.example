# Environment variables configuration
PROJECT_NAME="Employee Learning Path Advisory Agent"
VERSION="1.0.0"
API_V1_STR="/api"
PORT=8000

# MongoDB Configuration (Falls back automatically to local file cache if connection fails)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="learning_advisory_agent"

# ==========================================
# Multi-LLM Provider Fallback Configuration
# ==========================================

# Primary provider
LLM_PRIMARY_PROVIDER=gemini

# Provider priority order
LLM_FALLBACK_ORDER=gemini,openai,grok

# Gemini (Google)
# Single or comma-separated keys for safe internal rotation
GEMINI_API_KEYS=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# xAI Grok
XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-3-mini

# Optional timeout in seconds
LLM_REQUEST_TIMEOUT=30
